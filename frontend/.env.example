# URL of the NestJS backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Must match the BETTER_AUTH_SECRET in the backend .env
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Used by Better Auth server-side helpers inside Next.js
BETTER_AUTH_URL=http://localhost:3001
